
<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Tweet</title>
</head>
<style>
    html{
        background-color:<%=backgroundColor%>
    }
    body {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 15vh;
    }
    #tweet {
        width: 500px;
        max-width: 90vw;
        min-height: 300px;
        padding: 20px;
        box-sizing: border-box;
        color: <%=textColor%>;
        border: <%=borderSize%>px <%=borderStyle%> <%=borderColor%>;
        font-size: <%=fontSize%>px;
        background-color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    #request {
        color: white;
        text-shadow: 2px 2px 4px #000000;
    }
</style>
<body>
    <div id="tweet" >
        <%- tweet %>
    </div>
    <p id="request">Request Number (for lookup purposes): <%-requestNumber%> </p>
 
    
</body>

</html>
